# Copy to .env (never commit .env). Dev-only defaults.
# No-admin default: use free cloud tiers (no Docker needed).
# Postgres+PostGIS: Neon free tier (neon.tech, PostGIS supported) → paste URL below.
# Redis: Upstash free tier (upstash.com) → paste URL below.
# S3 images: Cloudflare R2 free 10GB (or local MinIO via Docker if you install it).
# Local Docker path (needs one admin approval): see infra/docker/docker-compose.yml.
DATABASE_URL=postgres://fmcg:fmcg_dev_only@localhost:5432/fmcg
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fmcg-dev
S3_ACCESS_KEY=fmcg
S3_SECRET_KEY=fmcg_dev_only_123
JWT_SECRET=change_me_in_production
PSP_PROVIDER=paystack-sandbox
PSP_SECRET_KEY=
AI_PROVIDER=ollama
AI_MODEL=llama3.1
# Cloud LLM (Groq free tier recommended — free, no card, console.groq.com → API Keys):
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-20b
# Neon AI Gateway alternative (needs paid Neon plan — pricier, skip for pilot):
# AI_PROVIDER=gateway
# AI_BASE_URL=https://<branch-id>-api.ai.<region>.aws.neon.tech/v1
# AI_API_KEY=<NEON_AI_GATEWAY_TOKEN>
# AI_MODEL=claude-haiku-4-5
